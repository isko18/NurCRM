# Скопируйте в .env и при необходимости переопределите значения.

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# База данных (PostgreSQL по умолчанию)
DB_ENGINE=postgresql
DB_NAME=warehouse_service
DB_USER=nuruser
DB_PASSWORD=nurpass2025
DB_HOST=127.0.0.1
DB_PORT=5432

# Для локального прогона на SQLite:
# DB_ENGINE=sqlite

# Кэш: если задан REDIS_URL — используется django_redis, иначе локальный LocMemCache.
# REDIS_URL=redis://127.0.0.1:6379/1

# JWT
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
